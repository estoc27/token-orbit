{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Orbit",
  "version": "0.1.0",
  "identifier": "dev.token-orbit.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "hud",
        "title": "Token Orbit",
        "width": 320,
        "height": 240,
        "minWidth": 240,
        "minHeight": 120,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
